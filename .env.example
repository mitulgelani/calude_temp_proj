# ── Site ─────────────────────────────────────────────────────────────
# Your production URL (no trailing slash). On Vercel this defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@your-domain.com

# ── Supabase (supabase.com → Project settings → API) ─────────────────
# Leave empty to run in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Instagram (developers.facebook.com → your app → Instagram → API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Any random string; paste the same value in the App Dashboard webhook settings.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v25.0

# ── Security ─────────────────────────────────────────────────────────
# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# Any random string; Vercel sends it to the token refresh cron.
CRON_SECRET=

# ── Payments (optional, Dodo Payments static checkout links) ─────────
# Optional overrides (live defaults live in lib/billing.ts)
DODO_PRODUCT_CREATOR_MONTHLY=
DODO_PRODUCT_CREATOR_YEARLY=
DODO_PRODUCT_STUDIO_MONTHLY=
DODO_PRODUCT_STUDIO_YEARLY=
DODO_BUSINESS_ID=
DODO_CHECKOUT_BASE=
DODO_WEBHOOK_SECRET=
# Comma-separated product IDs per plan
DODO_PRODUCTS_CREATOR=
DODO_PRODUCTS_STUDIO=
